{
  "name": "cloudrop",
  "version": "0.2.0",
  "description": "Fast, resumable, direct-to-bucket file uploads for Cloudflare R2 and S3-compatible storage.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vcode-sh/cloudrop.git",
    "directory": "packages/cloudrop"
  },
  "homepage": "https://github.com/vcode-sh/cloudrop#readme",
  "bugs": {
    "url": "https://github.com/vcode-sh/cloudrop/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "default": "./dist/next.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./adapters/sql": {
      "types": "./dist/adapters/sql.d.ts",
      "default": "./dist/adapters/sql.js"
    },
    "./adapters/drizzle": {
      "types": "./dist/adapters/drizzle.d.ts",
      "default": "./dist/adapters/drizzle.js"
    },
    "./adapters/prisma": {
      "types": "./dist/adapters/prisma.d.ts",
      "default": "./dist/adapters/prisma.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run --project unit",
    "package:check": "../../scripts/check-package.sh"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.45.0 <1 || >=1.0.0-rc.5 <2",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@cloudflare/workers-types": "5.20261119.1",
    "@libsql/client": "^0.18.0",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@size-limit/esbuild": "^14.3.0",
    "@size-limit/file": "^14.3.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "aws4fetch": "^1.0.20",
    "better-sqlite3": "^13.2.0",
    "drizzle-orm": "1.0.0-rc.5",
    "fast-check": "^4.10.3",
    "happy-dom": "^21.0.4",
    "pg": "^8.23.1",
    "postgres": "^4.1.1",
    "prisma": "^7.10.1",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "size-limit": "^14.3.0",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  }
}
