// The database lane's Prisma schema on SQLite: this generator and datasource, plus the models in cloudrop.prisma
// beside it. scripts/test-db.sh generates the client into packages/cloudrop/.prisma-client/sqlite (git-ignored).

generator client {
  provider = "prisma-client"
  output   = "../../../../../.prisma-client/sqlite"
}

datasource db {
  provider = "sqlite"
}
