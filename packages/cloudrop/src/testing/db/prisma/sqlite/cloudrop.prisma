// cloudrop's tables for prismaStore() on SQLite (spec M5 §3). Copy both models into your schema and create them with a
// migration: the model and field names are yours to change, the table and column names are fixed. Times are BigInt
// milliseconds since the epoch, as the store writes them: Prisma stores DateTime differently on SQLite, and Int is
// 32-bit.

model CloudropFile {
  id          String  @id
  route       String
  key         String
  owner       String?
  status      String
  name        String
  type        String
  size        BigInt
  uploadId    String? @map("upload_id")
  metadata    String?
  result      String?
  claim       String?
  claimedAt   BigInt? @map("claimed_at")
  expiresAt   BigInt  @map("expires_at")
  createdAt   BigInt  @map("created_at")
  updatedAt   BigInt  @map("updated_at")
  completedAt BigInt? @map("completed_at")
  endedAt     BigInt? @map("ended_at")
  cleanedAt   BigInt? @map("cleaned_at")

  @@index([status, expiresAt])
  @@index([status, claimedAt])
  @@index([status, cleanedAt, endedAt])
  @@index([owner, status])
  @@index([key])
  @@map("cloudrop_files")
}

model CloudropUsage {
  owner         String @id
  reservedBytes BigInt @map("reserved_bytes")
  activeBytes   BigInt @map("active_bytes")
  files         Int
  updatedAt     BigInt @map("updated_at")

  @@map("cloudrop_usage")
}
