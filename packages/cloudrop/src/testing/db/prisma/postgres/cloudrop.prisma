// cloudrop's tables for prismaStore() on Postgres (spec M5 §3). Copy both models into your schema and create them with
// a migration: the model and field names are yours to change, the table and column names are fixed. Prisma's schema
// has no CHECK constraints: add the counters' `CHECK (… >= 0)` from the SQL DDL to the generated migration.

model CloudropFile {
  id          String    @id
  route       String
  key         String
  owner       String?
  status      String
  name        String
  type        String
  size        BigInt
  uploadId    String?   @map("upload_id")
  metadata    String?
  result      String?
  claim       String?
  claimedAt   DateTime? @map("claimed_at") @db.Timestamptz(3)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  createdAt   DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @map("updated_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  endedAt     DateTime? @map("ended_at") @db.Timestamptz(3)
  cleanedAt   DateTime? @map("cleaned_at") @db.Timestamptz(3)
  requestKey  String?   @map("request_key")

  @@index([status, expiresAt])
  @@index([status, claimedAt])
  @@index([status, cleanedAt, endedAt])
  @@index([owner, status])
  @@index([key])
  @@index([route, requestKey])
  @@map("cloudrop_files")
}

model CloudropUsage {
  owner         String   @id
  reservedBytes BigInt   @map("reserved_bytes")
  activeBytes   BigInt   @map("active_bytes")
  files         Int
  updatedAt     DateTime @map("updated_at") @db.Timestamptz(3)

  @@map("cloudrop_usage")
}
