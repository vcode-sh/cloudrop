{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "isolatedDeclarations": false,
    // ../../scripts has no node_modules of its own, so its tests would not find vitest without this mapping.
    "paths": { "vitest": ["./node_modules/vitest"] }
  },
  "include": ["src", "fixtures", "vitest.config.ts", "tsdown.config.ts", "../../scripts"],
  // The consumer fixture compiles against the packed tarball, in scripts/check-package.sh.
  "exclude": ["fixtures/consumer-types"]
}
