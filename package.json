{
  "name": "cloudrop-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "check": "biome check . && bun scripts/check-file-size.ts",
    "fix": "biome check --write .",
    "typecheck": "bun run --filter cloudrop typecheck",
    "test": "bun run --filter cloudrop test",
    "test:live": "bun scripts/test-live-r2.ts",
    "test:rustfs": "scripts/test-rustfs.sh",
    "test:wrangler": "scripts/test-wrangler.sh",
    "build": "bun run --filter cloudrop build",
    "package:check": "bun run --filter cloudrop package:check",
    "verify": "bun run check && bun run typecheck && bun run test && bun run build && bun run package:check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8"
  }
}
