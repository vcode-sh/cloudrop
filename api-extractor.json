{
  "$schema": "https://developer.microsoft.com/json-schemas/api-extractor/v7/api-extractor.schema.json",
  "projectFolder": "packages/cloudrop",
  "mainEntryPointFilePath": "<projectFolder>/dist/index.d.ts",
  "newlineKind": "lf",
  "compiler": {
    "overrideTsconfig": {
      "compilerOptions": {
        "target": "ES2023",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2024", "DOM", "DOM.Iterable"],
        "types": [],
        "strict": true,
        "skipLibCheck": true
      },
      "include": ["dist/**/*.d.ts"]
    }
  },
  "apiReport": {
    "enabled": true,
    "reportFileName": "<unscopedPackageName>",
    "reportFolder": "<projectFolder>/node_modules/.api-extractor/reports/",
    "reportTempFolder": "<projectFolder>/node_modules/.api-extractor/temp/",
    "includeForgottenExports": true
  },
  "docModel": { "enabled": false },
  "dtsRollup": { "enabled": false },
  "tsdocMetadata": { "enabled": false },
  "messages": {
    "compilerMessageReporting": { "default": { "logLevel": "error" } },
    "extractorMessageReporting": {
      "default": { "logLevel": "error", "addToApiReportFile": false },
      "ae-missing-release-tag": { "logLevel": "none" },
      "ae-forgotten-export": { "logLevel": "none", "addToApiReportFile": true },
      "ae-incompatible-release-tags": { "logLevel": "none", "addToApiReportFile": true }
    },
    "tsdocMessageReporting": { "default": { "logLevel": "none" } }
  }
}
