{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!spikes",
      "!**/.wrangler",
      "!**/.state",
      "!.superpowers",
      "!**/*.md"
    ]
  },
  "formatter": { "indentStyle": "space", "lineWidth": 120 },
  "linter": { "rules": { "preset": "recommended" } }
}
