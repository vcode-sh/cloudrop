{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!spikes",
      "!**/.wrangler",
      "!**/.state",
      "!**/.prisma-client",
      "!**/.next",
      "!**/next-env.d.ts",
      "!**/test-results",
      "!**/playwright-report",
      "!.superpowers",
      "!**/*.md"
    ]
  },
  "formatter": { "indentStyle": "space", "lineWidth": 120 },
  "linter": {
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noExcessiveCognitiveComplexity": { "level": "error", "options": { "maxAllowedComplexity": 15 } }
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/cloudrop/**", "!packages/cloudrop/src/react.ts", "!packages/cloudrop/src/react/**"],
      "linter": { "domains": { "react": "none" } }
    },
    {
      "includes": ["packages/cloudrop/src/client.ts", "packages/cloudrop/src/client/**", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/storage/**",
                      "**/server/**",
                      "**/testing/**",
                      "**/index",
                      "**/index.*",
                      "**/next",
                      "**/next.*",
                      "**/node",
                      "**/node.*",
                      ".",
                      "./",
                      "..",
                      "../",
                      "cloudrop"
                    ],
                    "message": "cloudrop/client must not import storage, server or test code, nor another entry that pulls them in. Import from errors, input, part-size, plan or protocol."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/cloudrop/src/store/**", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/server/**",
                      "!**/server/store",
                      "!**/server/store.ts",
                      "**/client/**",
                      "**/storage/**",
                      "**/testing/**",
                      "**/protocol/**",
                      "**/adapters/**",
                      "**/adapters",
                      "**/index",
                      "**/index.*",
                      "**/next",
                      "**/next.*",
                      "**/node",
                      "**/node.*",
                      "**/react",
                      "**/react.*",
                      "**/client",
                      "**/client.*",
                      "cloudrop",
                      "cloudrop/*"
                    ],
                    "message": "The SQL core must not import an adapter, an entry, or server, client, storage or test code. It may import the store types (server/store) and errors."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/cloudrop/src/adapters/**", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/server/**",
                      "!**/server/store",
                      "!**/server/store.ts",
                      "!**/server/route",
                      "!**/server/route.ts",
                      "**/client/**",
                      "**/storage/**",
                      "**/testing/**",
                      "**/protocol/**",
                      "**/index",
                      "**/index.*",
                      "**/next",
                      "**/next.*",
                      "**/node",
                      "**/node.*",
                      "**/react",
                      "**/react.*",
                      "**/client",
                      "**/client.*",
                      "cloudrop",
                      "cloudrop/*"
                    ],
                    "message": "An adapter imports only the SQL core (store/sql), the store types (server/store), routeFor (server/route) and errors, so it pulls no other server, client or storage code into an app."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
