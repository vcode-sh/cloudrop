{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!spikes",
      "!**/.wrangler",
      "!**/.state",
      "!**/.next",
      "!**/next-env.d.ts",
      "!**/test-results",
      "!**/playwright-report",
      "!.superpowers",
      "!**/*.md"
    ]
  },
  "formatter": { "indentStyle": "space", "lineWidth": 120 },
  "linter": {
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noExcessiveCognitiveComplexity": { "level": "error", "options": { "maxAllowedComplexity": 15 } }
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/cloudrop/src/client.ts", "packages/cloudrop/src/client/**", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/storage/**",
                      "**/server/**",
                      "**/testing/**",
                      "**/index",
                      "**/index.*",
                      "**/next",
                      "**/next.*",
                      "**/node",
                      "**/node.*",
                      "cloudrop"
                    ],
                    "message": "cloudrop/client must not import storage, server or test code, nor another entry that pulls them in. Import from errors, input, plan or protocol."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
