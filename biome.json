{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!spikes",
      "!**/.wrangler",
      "!**/.state",
      "!.superpowers",
      "!**/*.md"
    ]
  },
  "formatter": { "indentStyle": "space", "lineWidth": 120 },
  "linter": {
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noExcessiveCognitiveComplexity": { "level": "error", "options": { "maxAllowedComplexity": 15 } }
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/cloudrop/src/client.ts", "packages/cloudrop/src/client/**", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/storage/**", "**/server/**"],
                    "message": "cloudrop/client must not import storage or server code. Import from errors, input, plan or protocol."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
